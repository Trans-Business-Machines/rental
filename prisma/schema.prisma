generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ------------------------ ENUMS ------------------------
 */

enum PriceDuration {
  one_night
  weekly
  monthly
}

enum Unit_Status {
  booked
  reserved
  maintenance
  available
  occupied
}

enum IdType {
  national_id
  passport
}

enum Booking_Status {
  pending
  reserved
  checked_in
  checked_out
  cancelled
}

enum Guest_Verification {
  pending
  verified
  rejected
}

enum BookingRequestStatus {
  pending
  approved
  rejected
  cancelled
}

enum InventoryCategory {
  electronics
  furniture
  bedroom
  cutlery
  linens
  kitchen_consumables
  laundry
  office
}

enum UnitOfMeasure {
  pieces
  pairs
  sets
  kg
  litres
  sachets
  packets
  bottles
  rolls
}

enum InventoryItemStatus {
  active
  discontinued
}

enum AssignmentStatus {
  active // out in a unit, return expected
  issued // out and consumed, no return expected (terminal at creation)
  partial // some returned, remainder still outstanding
  closed // fully resolved — returned, or written off
}

enum IssueType {
  damaged
  missing
  worn_out
}

enum IssueResolution {
  pending
  repair
  replace
  discard
}

enum IssueStatus {
  open
  resolved
}

/**
 * ------------------------ MODELS ------------------------
 */

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  role          String    @default("user")
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime
  updatedAt     DateTime

  sessions Session[]
  accounts Account[]

  // Inventory related relations
  assignments    InventoryAssignment[] @relation("ItemsAssigned")
  stockReceived  RestockLog[]          @relation("StockReceived")
  issuesReported ItemIssue[]           @relation("IssuesReported")
  issuesResolved ItemIssue[]           @relation("IssuesResolved")
  usageLogged    UsageLog[]            @relation("UsageLogged")

  // Invitation relations
  invitations Invitation[] @relation("UserInvitations")
  invitedBy   Invitation[] @relation("InvitedBy")

  // Booking request relations
  bookingRequestsCreated  BookingRequest[] @relation("RequestedBy")
  bookingRequestsReviewed BookingRequest[] @relation("ReviewedBy")

  // Booking relations
  bookingsRequested Booking[] @relation("BookingRequestedBy")
  bookingsApproved  Booking[] @relation("BookingApprovedBy")

  // Guest registered
  guestRegistered Guest[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Property {
  id           Int       @id @default(autoincrement())
  name         String
  address      String
  type         String
  totalUnits   Int?
  occupied     Int       @default(0)
  status       String    @default("active")
  description  String
  image        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  maxBedrooms  Int?
  maxBathrooms Int?

  amenities       Amenity[]
  inventoryItems  InventoryItem[]
  bookings        Booking[]
  units           Unit[]
  media           Media[]
  bookingRequests BookingRequest[]

  @@map("properties")
}

model Unit {
  id         Int         @id @default(autoincrement())
  name       String
  propertyId Int
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       String
  status     Unit_Status @default(available)
  bedrooms   Int         @default(1)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  bathrooms  Int?
  maxGuests  Int?

  bookings             Booking[]
  media                Media[]
  bookingRequests      BookingRequest[]
  inventoryAssignments InventoryAssignment[]

  @@map("units")
}

model Amenity {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  icon        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties Property[]

  @@map("amenities")
}

model Guest {
  id          Int    @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String @unique
  phone       String
  dateOfBirth String
  nationality String

  idType         IdType  @default(national_id)
  idNumber       String?
  passportNumber String?
  idFrontUrl     String?
  idBackUrl      String?
  passportUrl    String?

  notes      String?
  address    String?
  city       String?
  country    String?
  occupation String?
  employer   String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  registrationDate         DateTime? @default(now())

  lastStay    DateTime?
  totalStays  Int?      @default(0)
  totalNights Int?      @default(0)
  totalSpent  Int?      @default(0)

  rating             Float?
  blacklisted        Boolean?            @default(false)
  verificationStatus Guest_Verification? @default(pending)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  registeredById String?
  registeredBy   User?   @relation(fields: [registeredById], references: [id])

  bookings        Booking[]
  checkoutReports CheckoutReport[]
  bookingRequests BookingRequest[]

  @@map("guests")
}

model Booking {
  id         Int      @id @default(autoincrement())
  guestId    Int
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId     Int
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  priceDuration PriceDuration @default(one_night)
  unitPrice     Int
  period        Int           @default(1)
  discountRate  Float?
  totalAmount   Int

  checkInDate  DateTime
  checkOutDate DateTime

  numberOfGuests Int
  source         String
  purpose        String

  // Payment details
  paymentCode   String @unique
  paymentMethod String

  specialRequests String?
  status          Booking_Status @default(pending)

  requestedById String?
  requestedBy   User?     @relation("BookingRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?     @relation("BookingApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  checkoutReport CheckoutReport?

  @@map("bookings")
}

model InventoryItem {
  id         String   @id @default(cuid(2))
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  category    InventoryCategory
  itemName    String
  description String?

  unitOfMeasure     UnitOfMeasure @default(pieces)
  availableQuantity Decimal       @default(0) @db.Decimal(12, 2)
  restockAt         Decimal       @default(0) @db.Decimal(12, 2)

  unitCost Int?
  status   InventoryItemStatus @default(active)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  restocks    RestockLog[]
  assignments InventoryAssignment[]
  issues      ItemIssue[]
  usageLogs   UsageLog[]

  @@unique([propertyId, itemName])
  @@index([propertyId, category])
  @@index([propertyId, status])
  @@map("inventory_items")
}

model RestockLog {
  id              String        @id @default(cuid(2))
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  quantity Decimal @db.Decimal(12, 2)
  unitCost Int?

  receivedById String
  receivedBy   User   @relation("StockReceived", fields: [receivedById], references: [id], onDelete: Restrict)

  receivedAt DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  @@index([inventoryItemId, receivedAt])
  @@index([receivedById])
  @@map("restock_logs")
}

model InventoryAssignment {
  id              String        @id @default(cuid(2))
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  unitId          Int
  unit            Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)

  quantity           Decimal @db.Decimal(12, 2)
  returnedQuantity   Decimal @default(0) @db.Decimal(12, 2)
  // Gone from the unit for good (discarded/replaced issues). Never credited to stock.
  writtenOffQuantity Decimal @default(0) @db.Decimal(12, 2)
  serialNumber       String?

  status AssignmentStatus @default(active)

  assignedBy   User   @relation("ItemsAssigned", fields: [assignedById], references: [id])
  assignedById String

  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues ItemIssue[]

  @@index([inventoryItemId, status])
  @@index([unitId, status])
  @@map("inventory_assignments")
}

model ItemIssue {
  id              String               @id @default(cuid(2))
  inventoryItemId String
  inventoryItem   InventoryItem        @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  assignmentId    String?
  assignment      InventoryAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  // Set when the issue was raised during a guest checkout inspection.
  checkoutReportId Int?
  checkoutReport   CheckoutReport? @relation(fields: [checkoutReportId], references: [id], onDelete: SetNull)

  issueType        IssueType
  quantityAffected Decimal   @default(1) @db.Decimal(12, 2)
  description      String

  reportedById String
  reportedBy   User     @relation("IssuesReported", fields: [reportedById], references: [id], onDelete: Restrict)
  reportedAt   DateTime @default(now())

  status          IssueStatus     @default(open)
  resolution      IssueResolution @default(pending)
  resolutionNotes String?
  cost            Int             @default(0)

  resolvedById String?
  resolvedBy   User?     @relation("IssuesResolved", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, reportedAt])
  @@index([inventoryItemId, reportedAt])
  @@index([assignmentId])
  @@index([checkoutReportId])
  @@index([reportedById])
  @@map("item_issues")
}

model UsageLog {
  id              String        @id @default(cuid(2))
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  quantityUsed Decimal @db.Decimal(12, 2)

  usedById String
  usedBy   User   @relation("UsageLogged", fields: [usedById], references: [id], onDelete: Restrict)

  usedAt    DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  @@index([inventoryItemId, usedAt])
  @@index([usedById])
  @@map("usage_logs")
}

model CheckoutReport {
  id              Int      @id @default(autoincrement())
  bookingId       Int      @unique
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guestId         Int
  guest           Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  checkoutDate    DateTime
  inspector       String
  totalDamageCost Int      @default(0)
  status          String   @default("completed")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  issues ItemIssue[]

  @@map("checkout_reports")
}

model Invitation {
  id          String    @id @default(uuid())
  email       String    @unique
  name        String?
  role        String // 'user' or 'admin'
  token       String    @unique
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  userId      String? // The user created after accepting invite
  user        User?     @relation("UserInvitations", fields: [userId], references: [id])
  invitedById String? // The admin who sent the invite
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id])

  @@map("invitations")
}

model Media {
  id           String    @id @default(cuid())
  filename     String    @unique
  originalName String
  fileSize     Int
  mimeType     String
  propertyId   Int?
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId       Int?
  unit         Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  filePath   String
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@index([propertyId])
  @@index([unitId])
  @@map("media")
}

model UnitTypePricing {
  id       Int           @id @default(autoincrement())
  unitType String // "1 bedroom", "2 bedroom"
  duration PriceDuration
  price    Int
  nights   Int? // 1, 7, 30, or null (calculated for custom)

  // For custom duration (seasonal pricing)
  fromDate DateTime? // Required if duration = custom
  toDate   DateTime? // Required if duration = custom

  // Discount per pricing entry
  discountRate Float? // e.g., 0.10 for 10%, null = no discount

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("unit_type_pricing")
}

model BookingRequest {
  id Int @id @default(autoincrement())

  // Agent who created the request
  requestedById String
  requestedBy   User   @relation("RequestedBy", fields: [requestedById], references: [id])

  // Admin or SuperAdmin who approved/rejected (null while pending)
  reviewedById String?
  reviewedBy   User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // Request status
  status          BookingRequestStatus @default(pending)
  rejectionReason String?
  cancelReason    String?

  // Guest (always a real Guest record)
  guestId Int
  guest   Guest @relation(fields: [guestId], references: [id])

  // Booking Details
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])
  unitId     Int
  unit       Unit     @relation(fields: [unitId], references: [id])

  checkInDate    DateTime
  checkOutDate   DateTime
  numberOfGuests Int

  priceDuration PriceDuration
  unitPrice     Int
  period        Int           @default(1)
  discountRate  Float?
  totalAmount   Int

  paymentCode   String
  paymentMethod String

  purpose         String?
  specialRequests String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("booking_requests")
}

model PaymentSettings {
  id            String @id @default(cuid())
  paybillNumber String @unique
  accountNumber String @unique

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_settings")
}
